	(text "Board function: 10-way signed-32 argmax + 32-bit score staging\nModule sheets on this board: S06_Argmax.kicad_sch, S12B_ScoreLatch.kicad_sch\nExternal signals: 26 (power pins are fixed on every header)."
		(exclude_from_sim no)
		(at 15 20 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "6faf815c-5b95-4706-8dd2-ca70e4c91917")
	)

	(text "Pinout: 1-4 +5V, 5-8 +3V3 (reserved), 9-14 GND, 15-40 signals.\nSignal order follows the net grouping in tools/backplane.py; the machine-readable map is output/backplane/.\nInternal board nets (engine ACC/REQ pairs, IN_DATA byte buses) are deliberately absent: they never leave the board."
		(exclude_from_sim no)
		(at 15 28 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "d101c0c4-8a4a-4961-b079-2e4f5f9e4c53")
	)

