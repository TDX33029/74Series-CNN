	(text "Byte timing: S09's write counter FC_BYTE[1:0] selects ACC byte 0..3\non the 4:1 mux; each E_REQ visit writes one byte, and FC2 loops\nE_REQ/E_ADDR_OUT/E_WRITE four times (ROM A12 = BYTE_LAST).  FC1\nwrites one byte and ignores BYTE_LAST (FC_SEL=0).\nQSTB and DONE are a two-stage shift of START, so the same handshake\nserves both layers.  No bias adder; FC2 raw ACC is the signed score."
		(exclude_from_sim no)
		(at 18 75 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "3e4ae2f4-ec0b-4628-afc4-b6a59b730d6b")
	)

