	(text "Master code: 0=none/host, 1=C1, 2=C2, 3=FC, 4=ARGMAX.  Region code: 0=IN, 1=W, 2=OUT, 3=B, 4=Q, 5=MC, 7=none.\nThe three 74HC148 region encoders are mutually exclusive in time; U6/U7 select the active engine's code with the same C1>C2>FC priority as U1.\nMap ROM contents: model/busmap/bus_map.bin (tools/gen_bus_map.py)."
		(exclude_from_sim no)
		(at 600 400 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "671d2b65-a41d-41f9-9e2b-d81135f0d00b")
	)

	(text "REQ = C1_REQ | C2_REQ | FC_REQ | SCORE_RD.  WE = (C1_REQ & C1_WE) | (C2_REQ & C2_WE) | (FC_REQ & FC_WE).\nS02 nCE/nOE/nWE drive S04 directly; MEM_ACK/DONE/BUSY fan out to all three engines as global labels.\nTag buffer drives ADDR[23:16]={000,MEM_SEL}; MEM_SEL and tag buffers use active-low OE=LOAD_EN, complementary to the S10 load buffers (OE=NOT_LOAD_EN)."
		(exclude_from_sim no)
		(at 600 430 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "c860bd17-639d-4901-a607-7d6aefe982f0")
	)

	(embedded_fonts no)
)
