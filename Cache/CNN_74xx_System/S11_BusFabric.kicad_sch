	)

	(text "MASTER = {C1,C2,FC} busy priority (74HC148); REGION = active engine's Cx_MEM_nCE_IN/W/OUT/B/Q/MC one-hot code (74HC148 per engine).\n27C512 map ROM address A[6:0] = {FC_SEL, MASTER[1:0], REGION[2:0], 0}; D[4:0] = MEM_SEL[4:0]; unused addresses = 0x1F (no device).\nFabric outputs are enabled by active-low LOAD_EN (LOAD_EN=0, inference); S10 owns MEM_SEL/ADDR while LOAD_EN=1."
		(exclude_from_sim no)
		(at 20 23 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "55c25c84-bb10-47fb-8a7f-53761c5b99d4")
	)

