	(text "S12B  ARGMAX SCORE STAGING (4x 74HCT574 + 74HC238)"
		(exclude_from_sim no)
		(at 20 16 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "17cea762-e4c3-470f-9553-dedfe31d8658")
	)

	(text "Four 74HCT574 latches hold bytes 0..3 of a little-endian signed-32 score word.\n74HC238 decodes SCORE_ADDR[1:0] into the four latch clocks while MEM_ACK is high (S02 data-valid capture).\nThe latches are a staging register, not a second memory: S04 presents the selected byte on DATA while the decoder output is high.\nS06 generates the byte address and S04/S02 execute one REQ/ACK transaction per byte."
		(exclude_from_sim no)
		(at 20 23 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "8f9442c5-57fb-47cd-9478-0c7484482856")
	)

