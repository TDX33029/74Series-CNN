	(text "Board function: 2x2 stride-2 max pool 10x10x16 -> 5x5x16\nModule sheets on this board: S05_Pool2.kicad_sch, S12A_PoolLatch2.kicad_sch\nExternal signals: 53 (power pins are fixed on every header)."
		(exclude_from_sim no)
		(at 15 20 0)
		(effects
