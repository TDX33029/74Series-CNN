	(text "Board function: 2x2 stride-2 max pool 12x12x8 -> 6x6x8\nModule sheets on this board: S05_Pool1.kicad_sch, S12A_PoolLatch1.kicad_sch\nExternal signals: 53 (power pins are fixed on every header)."
		(exclude_from_sim no)
		(at 15 20 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "5b9e97f4-8f37-4a91-9918-399df1d2fea3")
	)

	(text "Pinout: 1-4 +5V, 5-8 +3V3 (reserved), 9-14 GND, 15-40 signals.\nSignal order follows the net grouping in tools/backplane.py; the machine-readable map is output/backplane/.\nInternal board nets (engine ACC/REQ pairs, IN_DATA byte buses) are deliberately absent: they never leave the board."
		(exclude_from_sim no)
		(at 15 28 0)
		(effects
