	(text "Board function: 3x3x8 -> 16ch convolution engine + ACC>>9 requant\nModule sheets on this board: S08_Conv2.kicad_sch, S15_Requant_C2.kicad_sch\nExternal signals: 43 (power pins are fixed on every header)."
		(exclude_from_sim no)
		(at 15 20 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "b073ed25-8469-4711-b845-a3113fcfffd0")
	)

	(text "Pinout: 1-4 +5V, 5-8 +3V3 (reserved), 9-14 GND, 15-40 signals.\nSignal order follows the net grouping in tools/backplane.py; the machine-readable map is output/backplane/.\nInternal board nets (engine ACC/REQ pairs, IN_DATA byte buses) are deliberately absent: they never leave the board."
		(exclude_from_sim no)
		(at 15 28 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "90e2ba6f-14fe-4222-bc07-7127be95bddb")
	)

