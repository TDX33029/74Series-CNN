	(text "Select timing: S01 sets FC_SEL/POOL_SEL before asserting the matching *_START, and the engine raises BUSY for the whole run.\nFC2_BUSY / POOL2_BUSY therefore switch the mux before the first memory transaction and hold it until DONE.  The map ROM still sees FC_SEL / POOL_SEL from S01, so both sides agree on the weight/output window."
		(exclude_from_sim no)
		(at 80 340 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "467747a1-9d9a-43cd-9f5c-c688621cad45")
	)

	(text "Unused mux units are tied low with no-connect outputs.  All five packages are 74HC157 (quad 2:1, non-inverting); no bus buffers are added here because the engines drive the backplane directly and S04 owns the tri-state ADDR/DATA merge buffers."
		(exclude_from_sim no)
		(at 80 365 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "ce487318-25d4-414f-877e-ca2205a75832")
	)

