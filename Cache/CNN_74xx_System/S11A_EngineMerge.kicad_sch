	(text "S11A  ENGINE MERGE (PER-LAYER ENGINES -> SHARED S11 SLOT)"
		(exclude_from_sim no)
		(at 20 16 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
