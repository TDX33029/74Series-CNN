	(text "S06  ARGMAX: 10 signed-32 scores -> 4-bit class index"
		(exclude_from_sim no)
		(at 20 14 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "d74c9054-fa1e-4a61-8d28-35ee08473215")
	)

	(text "Interface: CLK, RESET_N, ARGMAX_START, SCORE_DATA[31:0], SCORE_ADDR[5:0], SCORE_RD, RESULT[3:0], RESULT_VALID, BUSY, DONE.\nEach class is four little-endian bytes at SCORE_ADDR = class*4+byte; MEM_ACK latches the byte lane in S12 and each read is one S02 transaction.  Class 0 initializes MAX/INDEX; classes 1..9 are compared with a signed 32-bit magnitude comparator.  UPDATE only on strict greater-than: ties keep the lower class number.  RESULT_VALID is held until the next ARGMAX_START."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.35 1.35)
			)
			(justify left top)
		)
		(uuid "01e106bd-50a1-41f8-8f4e-9b3d834a5bf5")
	)

