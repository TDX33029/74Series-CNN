	(text "Board function: Master/region encode, map ROM, REQ/WE merge, engine merge\nModule sheets on this board: S11_BusFabric.kicad_sch, S11A_EngineMerge.kicad_sch\nExternal signals: 72 (power pins are fixed on every header)."
		(exclude_from_sim no)
		(at 15 20 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "57e57bb3-f3bf-4302-a130-aa2f7fec4fef")
	)

	(text "Pinout: 1-4 +5V, 5-8 +3V3 (reserved), 9-14 GND, 15-40 signals.\nSignal order follows the net grouping in tools/backplane.py; the machine-readable map is output/backplane/.\nInternal board nets (engine ACC/REQ pairs, IN_DATA byte buses) are deliberately absent: they never leave the board."
		(exclude_from_sim no)
		(at 15 28 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "7d096043-fcd8-4f05-b8f6-63d9cae2fe75")
	)

