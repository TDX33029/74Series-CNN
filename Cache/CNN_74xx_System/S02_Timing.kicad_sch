	(text "T_IDLE -> T_SETUP -> T_WAIT(n) -> T_CAPTURE(read)/T_HOLD(write) -> T_RELEASE -> T_DONE.\nnCE/nOE/nWE are active-low.  DONE is issued only after the final hold cycle.  WAIT_READ/WAIT_WRITE are 4-bit inputs."
		(exclude_from_sim no)
		(at 20 23 0)
		(effects
