		(uuid "93c58430-55da-4957-b14b-7ff23c95db95")
	)

	(text "Pinout: 1-4 +5V, 5-8 +3V3 (reserved), 9-14 GND, 15-40 signals.\nSignal order follows the net grouping in tools/backplane.py; the machine-readable map is output/backplane/.\nInternal board nets (engine ACC/REQ pairs, IN_DATA byte buses) are deliberately absent: they never leave the board."
		(exclude_from_sim no)
		(at 15 28 0)
