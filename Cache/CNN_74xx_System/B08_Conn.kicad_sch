	(text "Board function: 400 -> 32 fully connected + FC1 uint8 requant\nModule sheets on this board: S09_FC1.kicad_sch, S17_FC1.kicad_sch\nExternal signals: 43 (power pins are fixed on every header)."
		(exclude_from_sim no)
		(at 15 20 0)
