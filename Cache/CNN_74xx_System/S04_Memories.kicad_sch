	(text "S04  Memory Array (7x 6264 feature SRAM, 4x 62256 weight SRAM, 8x W27C512 LUT ROM)"
		(exclude_from_sim no)
		(at 20 16 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "fbc7df4f-1bea-42d3-8a35-9cf2fadbe3a7")
	)

	(text "Independent chip select and independent 64 KB address window per device; no address multiplexing.\nDevice n occupies 0x{n:02X}0000..0x{n:02X}FFFF; ADDR[15:0] is the window offset and ADDR[23:16] must equal MEM_SEL.\nMEM_SEL 0..6 = feature SRAM, 8..11 = weights (SRAM, reloaded from SD at power-up), 20..27 = LUT pairs.\n12..15 (bias) and 16..19 (qparam) are reserved holes: the V2 requant has no bias adder and no zero point."
		(exclude_from_sim no)
		(at 20 24 0)
		(effects
			(font
				(size 1.35 1.35)
			)
			(justify left top)
		)
		(uuid "578ab48a-4e48-4ccb-9f6e-b8ec1211b6e2")
	)

