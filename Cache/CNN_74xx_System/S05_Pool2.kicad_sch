	(text "S05  POOL engine: 2x2 window, stride 2, unsigned max (POOL1 / POOL2)"
		(exclude_from_sim no)
		(at 20 14 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "35fdc4c4-9d2d-406d-8279-5fd1be3ccff9")
	)

	(text "Interface: CLK, RESET_N, P1_START, P2_START, POOL_SEL (0=POOL1, 1=POOL2), IN_DATA[7:0], POOL_IN_ADDR[12:0], POOL_OUT_DATA[7:0], POOL_OUT_ADDR[11:0], OUT_WE, POOL_BUSY, P1_DONE, P2_DONE, MEM_ACK, MEM_DONE, POOL_MEM_REQ, POOL_MEM_WE, POOL_MEM_nCE_IN, POOL_MEM_nCE_OUT, POOL_BUSY_N.\nPOOL_START = P1_START | P2_START (U42a); DONE is page-local POOL_DONE.\nPOOL1: C=8, H=24, W=24 -> 12x12x8 (1152 outputs, 4608 input bytes).  POOL2: C=16, H=10, W=10 -> 5x5x16 (400 outputs, 1600 input bytes).\nRead order per output: v0=(2oy,2ox), v1=(2oy,2ox+1), v2=(2oy+1,2ox), v3=(2oy+1,2ox+1).  POOL_IN_ADDR is held through RD and WT; data is captured at CP (assumes the S02 controller's 2-wait read)."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.35 1.35)
			)
			(justify left top)
		)
		(uuid "f8644eb6-6fe5-4688-860a-db708fdf6622")
	)

