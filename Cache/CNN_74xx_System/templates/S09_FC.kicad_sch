	(text "S09  FULLY-CONNECTED ENGINE  (FC1 and FC2)"
		(exclude_from_sim no)
		(at 15 10 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "8ef3fb75-b22f-4b20-aa51-9297ead5f911")
	)

	(text "FC1: 400 -> 32, uint8 + ReLU.  FC2: 32 -> 10, signed32 unified scale, little-endian.\nFC1 loop: neuron(0..31) -> index(0..399); 400 MAC/neuron; 12800 MAC total.\nFC2 loop: neuron(0..9) -> index(0..31);   32 MAC/neuron;   320 MAC total.\nFC_SEL=0 selects FC1, FC_SEL=1 selects FC2 (valid with FC1_START/FC2_START).\nIN_ADDR = index                                   FC1 0..399, FC2 0..31\nW_ADDR  = FC1 neuron*400 + index (0..12799)        FC2 neuron*32 + index (0..319)\nOUT_ADDR= FC1 neuron (0..31)                       FC2 neuron*4 + byte, byte=0..3 LE\nOutput order: FC1 neuron 0..31, one byte each; FC2 neuron 0..9, bytes 0..3 of each\nsigned32 score in little-endian order (Q0 is the LSB byte)."
		(exclude_from_sim no)
		(at 15 16 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "b6e0d75e-8a61-42a2-af04-0a7aa397ea96")
	)

	(text "4x LUT_Mult_Unit (S_LUT_Mult_1 interface), 4-deep pixel/weight pipeline, 4-product 18-bit adder tree, 32-bit accumulator (8x74HC283 + 4x74HCT574)."
		(exclude_from_sim no)
		(at 430 748 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "3df4d165-c103-4dfc-933e-ddd65ec99e1e")
	)

	(text "Requant core is gate-level on S17_Requant_FC (no macro): FC1 uint8+ReLU,\nFC2 signed-32 unified scale with four little-endian bytes (QSTB x4)."
		(exclude_from_sim no)
		(at 430 756 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "4fb63043-f5e7-472d-af5a-7397b28e5e82")
	)

