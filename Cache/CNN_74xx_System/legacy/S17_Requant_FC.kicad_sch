	(text "FC_SEL=0: FC1 Q = clamp(ACC >>> SHIFT, 0, 255), one QSTB at BC=0.\nFC_SEL=1: FC2 Q = raw ACC byte selected by BC[1:0], QSTB at BC=0..3,\nDONE at BC=3.  No bias, no zero point, no M multiplier, no parameter port."
		(exclude_from_sim no)
		(at 18 19 0)
		(effects
