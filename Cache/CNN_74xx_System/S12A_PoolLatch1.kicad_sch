	)

	(text "Always-enabled 74HCT541 isolates the shared byte bus from the Pool engine inputs.\nOne access per byte: S04 drives DATA[7:0], the Pool compares one byte and advances its address.\nThe buffer is powered from the board's +5V rail and has no control port on the backplane."
		(exclude_from_sim no)
		(at 15 19 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
