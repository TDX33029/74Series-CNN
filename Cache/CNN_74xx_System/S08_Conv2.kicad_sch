	(label "C2_MEM_STAT_BUSY"
		(at 1014.73 735.33 0)
		(fields_autoplaced yes)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "33d8efc1-388e-4ffa-a9fd-2e748974a59c")
	)

	(text "Microcode: A[4:0]=ST, A5=START, A6=POINT_LAST, A7=MEM_ACK, A8=MEM_DONE, A9=REQ_DONE, A10=SP_LAST.  ROM1[4:0]=next state, D5=BUSY, D6=DONE, D7=ACC_CLR_N; ROM2 D0=MAC_EN, D1=REQ, D2=WE, D3=OUT_STB, D4=ADD_SEL0, D5=ADD_SEL1, D6/D7=0.  State sequence 0..12 as on S07."
		(exclude_from_sim no)
		(at 430 620 0)
		(effects
			(font
				(size 0.9 0.9)
			)
			(justify left top)
		)
		(uuid "953e5b32-7f1a-4266-ac4c-a4cf987b475f")
	)

	(text "A/B path: A_LAT/B_LAT 574 + four hold-enabled 574 stages per operand (16x157) + eight 27C512 (two per lane).  PROD=A*B; the pipeline is frozen during S02 wait states.  CONV2 has 72 MACs (18 complete groups of four), so no padding is required."
		(exclude_from_sim no)
		(at 430 650 0)
		(effects
			(font
				(size 0.95 0.95)
			)
			(justify left top)
		)
		(uuid "2e0d144a-9bfb-4afc-8823-1ec2f8b85e5e")
	)

	(text "Requant: S15 computes Q = clamp(ACC >> 9, 0, 255) with a 74HCT574 output register and two 74HC74 handshake stages.  No bias, zero-point, multiplier or parameter port; symmetric quantization with bias trained to zero."
		(exclude_from_sim no)
		(at 430 680 0)
		(effects
			(font
				(size 0.95 0.95)
			)
			(justify left top)
		)
		(uuid "3b92e826-4327-47c3-87f5-603f90261511")
	)

	(text "Memory interface is shared: S02 drives MEM_nCE/nOE/nWE and MEM_ACK/DONE/BUSY globally; S11 merges C2_MEM_REQ/WE and maps the C2_MEM_nCE_* region code to MEM_SEL.  The 74HC138 is qualified by active-low MEM_nCE; C2_ADDR is driven only while C2_BUSY=1."
		(exclude_from_sim no)
		(at 430 710 0)
		(effects
			(font
				(size 0.95 0.95)
			)
			(justify left top)
		)
		(uuid "5ad8f441-f23a-47fe-a1bc-2adaa00774d5")
	)

