	(text "Board function: 5x5x1 -> 8ch convolution engine + ACC>>8 requant\nModule sheets on this board: S07_Conv1.kicad_sch, S13_Requant_C1.kicad_sch\nExternal signals: 43 (power pins are fixed on every header)."
		(exclude_from_sim no)
		(at 15 20 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "904a9aad-72ba-4e82-aa62-2ba882e0fe6d")
	)

	(text "Pinout: 1-4 +5V, 5-8 +3V3 (reserved), 9-14 GND, 15-40 signals.\nSignal order follows the net grouping in tools/backplane.py; the machine-readable map is output/backplane/.\nInternal board nets (engine ACC/REQ pairs, IN_DATA byte buses) are deliberately absent: they never leave the board."
		(exclude_from_sim no)
		(at 15 28 0)
		(effects
