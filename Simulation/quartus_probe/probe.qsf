# Quartus Prime project settings for the toolchain probe.
# Target: ALIENTEK / 正点原子 EP4CE10F17C8N development board (Cyclone IV E).
# Deliberately no pin assignments: this is a compile-only probe.

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE10F17C8
set_global_assignment -name TOP_LEVEL_ENTITY probe_top
set_global_assignment -name VERILOG_FILE probe_top.v
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name POWER_DEFAULT_INPUT_IO_TOGGLE_RATE "12.5 %"

set_global_assignment -name LAST_QUARTUS_VERSION "18.0.0 Standard Edition"